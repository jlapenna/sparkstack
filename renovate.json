{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "ignoreDeps": [
    "pytest",
    "pytest-cov",
    "pytest-asyncio",
    "python"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "OpenClaw image build tools pinned in services/openclaw/docker/build-versions.json. Their custom managers never matched until the managerFilePatterns fix, so the first updates are multi-release catch-ups into the gateway and sandbox images: review them together instead of auto-merging.",
      "matchFileNames": ["services/openclaw/docker/build-versions.json"],
      "groupName": "openclaw build tools",
      "groupSlug": "openclaw-build-tools",
      "automerge": false
    },
    {
      "description": "Wait a day before proposing an npm release, matching the fleet's shared Renovate preset (jlapenna/agent-lcars renovate-preset.json), so a just-published or quickly yanked package never auto-merges.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    }
  ],
  "pep621": {
    "enabled": true
  },
  "ignorePaths": [
    "openclaw/**",
    "sparkrun/**",
    "sparkstack-registry/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s*- [A-Z_]+_VERSION=(?<currentValue>.*?)\\n"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"gogcli\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "steipete/gogcli"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"goplaces\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "steipete/goplaces"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"camsnap\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "steipete/camsnap"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"opencode\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "anomalyco/opencode"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"blogwatcher\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "go",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "github.com/Hyaxia/blogwatcher"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"wacli\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "go",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "github.com/steipete/wacli"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"openai-whisper\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "openai-whisper"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/openclaw/docker/build-versions\\.json$/"
      ],
      "matchStrings": ["\"nano-pdf\":\\s*\"v?(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "nano-pdf"
    }
  ]
}
